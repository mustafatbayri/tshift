# Bu dosyayi kopyalayip adini .env yap, sonra degerleri duzenle.
# .env dosyasi git'e GITMEZ (.gitignore'da) - sirlar depoya girmesin diye.

# Veritabani sahibi (migration calistirir, super kullanici).
# docker-compose bu degeri okur.
DB_PASSWORD=tshift_dev_2026

# Uygulamanin bagli oldugu kisitli rol (RLS'e TABI).
# API bu degeri okur. Bkz. db/rls/02-uygulama-rolu.sql
APP_DB_PASSWORD=tshift_app_dev_2026

# JWT imza anahtari. EN AZ 32 KARAKTER.
# T-34'e kadar bu satir burada YOKTU; ornegi takip eden biri JWT_SECRET'siz
# kalir ve koddaki sabiti kullanirdi. Artik verilmezse uygulama acilmaz.
JWT_SECRET=yerel-gelistirme-icin-en-az-otuz-iki-karakterlik-anahtar
